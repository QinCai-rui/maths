{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "skipLibCheck": true
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "scripts/ci/**/*.ts"]
}
