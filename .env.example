# HTTP listener
PORT=5185
HOST=0.0.0.0

# SQLite database path. Docker Compose mounts ./data at /data.
MATHEX_DB_PATH=/data/mathex.sqlite

# Collaborative sets remain in memory and are written after this many ms without
# another write. They are also flushed synchronously on SIGTERM/SIGINT.
MATHEX_COLLAB_PERSIST_DELAY_MS=30000

# Lock expiry and Socket.IO's maximum inbound message size.
MATHEX_COLLAB_LOCK_TTL_MS=30000
MATHEX_MAX_HTTP_BUFFER_BYTES=10485760
